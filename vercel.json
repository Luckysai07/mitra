{
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*).apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!download-apk|.*\\.apk).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/download-apk",
      "destination": "https://github.com/Luckysai07/mitra/releases/download/latest/mitra-app.apk",
      "statusCode": 302
    }
  ]
}
