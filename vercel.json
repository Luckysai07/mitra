{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/((?!download-apk).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/download-apk",
      "destination": "https://github.com/Luckysai07/mitra/releases/latest/download/app-release.apk",
      "statusCode": 302
    }
  ]
}
